---
input: "non-empty-list<string>"
output: function
---
/** @phpstan-assert-if-true non-empty-list<string> $value */
function isNonEmptyListString(mixed $value): bool
{
    if (
        !is_array($value) ||
        !array_is_list($value) ||
        $value === []
    ) {
        return false;
    }
    foreach ($value as $value1) {
        if (!is_string($value1)) {
            return false;
        }
    }
    return true;
}
