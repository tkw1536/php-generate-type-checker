---
input: "array<int|array<int>|array<string>>"
output: function
---
/** @phpstan-assert-if-true array<int|array<int>|array<string>> $value */
function isArrayIntArrayIntArrayString(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $value1) {
        if (
            !is_int($value1) &&
            !isArrayInt($value1) &&
            !isArrayString($value1)
        ) {
            return false;
        }
    }
    return true;
}


/** @phpstan-assert-if-true array<int> $value */
function isArrayInt(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $value1) {
        if (!is_int($value1)) {
            return false;
        }
    }
    return true;
}

/** @phpstan-assert-if-true array<string> $value */
function isArrayString(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $value1) {
        if (!is_string($value1)) {
            return false;
        }
    }
    return true;
}
