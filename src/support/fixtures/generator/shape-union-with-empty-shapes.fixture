---
input: "array{left: array{}, right: never[]}|array{}"
output: function
---
/** @phpstan-assert-if-true array{left: array{}, right: never[]}|array{} $value */
function isShapeOrShapeFldleftReqShapeFldrightReqPostfixArrayNever(mixed $value): bool
{
    return isShape($value) || isShapeFldleftReqShapeFldrightReqPostfixArrayNever($value);
}


/** @phpstan-assert-if-true array{} $value */
function isShape(mixed $value): bool
{
    return is_array($value);
}

/** @phpstan-assert-if-true array{left: array{}, right: never[]} $value */
function isShapeFldleftReqShapeFldrightReqPostfixArrayNever(mixed $value): bool
{
    return (
        is_array($value)
        && array_key_exists('left', $value)
        && array_key_exists('right', $value)
        && $value['right'] === []
    );
}
