---
input: "array{left: array{}, right: never[]}|array{}"
output: function
---
/** @phpstan-assert-if-true array{left: never[], right: never[]}|never[] $value */
function isArrayNeverOrShapeFldleftReqArrayNeverFldrightReqArrayNever(mixed $value): bool
{
    return ($value === [] || isShapeFldleftReqArrayNeverFldrightReqArrayNever($value));
}


/** @phpstan-assert-if-true array{left: never[], right: never[]} $value */
function isShapeFldleftReqArrayNeverFldrightReqArrayNever(mixed $value): bool
{
    return (
        is_array($value)
        && array_key_exists('left', $value)
        && $value['left'] !== []
        && array_key_exists('right', $value)
        && $value['right'] !== []
    );
}
