---
input: "object{foo: int, bar?: string}"
output: function
---
/** @phpstan-assert-if-true object{foo: int, bar?: string} $value */
function isObjectShapeFldbarOptStringFldfooReqInt(mixed $value): bool
{
    if (!is_object($value)
        || !property_exists($value, 'foo')
        || !is_int($value->foo)
    ) {
        return false;
    }
    if (property_exists($value, 'bar')) {
        return is_string($value->bar);
    }
    return true;
}
