---
input: "object{foo: int, bar?: string}"
output: function
---
/** @phpstan-assert-if-true object{foo: int, bar?: string} $value */
function isObjectFooIntBarString(mixed $value): bool
{
    return (
        is_object($value) &&
        property_exists($value, 'foo') &&
        is_int($value->foo) &&
        (
            !property_exists($value, 'bar') ||
            is_string($value->bar)
        )
    );
}
