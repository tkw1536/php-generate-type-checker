---
input: "array{x: non-empty-array<string, string>}"
output: function
---
/** @phpstan-assert-if-true array{x: non-empty-array<string, string>} $value */
function isArrayXNonEmptyArrayStringString(mixed $value): bool
{
    if (
        !is_array($value) ||
        !array_key_exists('x', $value) ||
        !is_array($value['x']) ||
        $value['x'] === []
    ) {
        return false;
    }
    foreach ($value['x'] as $key1 => $value1) {
        if (
            !is_string($key1) ||
            !is_string($value1)
        ) {
            return false;
        }
    }
    return true;
}
