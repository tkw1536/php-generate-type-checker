---
input: "array{foo: int, bar?: string}"
output: function
---
/** @phpstan-assert-if-true array{foo: int, bar?: string} $value */
function isShapeFldbarOptStringFldfooReqInt(mixed $value): bool
{
    if (
        !is_array($value) ||
        !array_key_exists('foo', $value) ||
        !is_int($value['foo'])
    ) {
        return false;
    }
    if (array_key_exists('bar', $value)) {
        return is_string($value['bar']);
    }
    return true;
}
