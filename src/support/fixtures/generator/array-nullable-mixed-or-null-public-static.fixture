---
input: "(array<string|null,mixed>)|null"
output: public_static
---
class TypeChecker
{
    /** @phpstan-assert-if-true array<null|string, mixed>|null $value */
    public static function isNullTypeOrArrayNullTypeOrStringToMixed(mixed $value): bool
    {
        return ($value === null || self::isArrayNullTypeOrStringToMixed($value));
    }

    /** @phpstan-assert-if-true array<null|string, mixed> $value */
    private static function isArrayNullTypeOrStringToMixed(mixed $value): bool
    {
        if (!is_array($value)) {
            return false;
        }
        foreach ($value as $key1 => $value1) {
            if (!($key1 === null || is_string($key1))) {
                return false;
            }
        }
        return true;
    }
}
