---
input: "(array<string|null,mixed>)|null"
output: public_static
---
class TypeChecker
{
    /** @phpstan-assert-if-true array<string|null, mixed>|null $value */
    public static function isArrayStringNullMixedNull(mixed $value): bool
    {
        return (is_array($value) || $value === null);
    }
}
