---
input: "array<string, string>"
output: function
---
/** @phpstan-assert-if-true array<string, string> $value */
function isArrayStringString(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $key1 => $value1) {
        if (
            !is_string($key1) ||
            !is_string($value1)
        ) {
            return false;
        }
    }
    return true;
}
