---
input: "array<string>|array<int>"
output: function
---
/** @phpstan-assert-if-true string[]|int<min, max>[] $value */
function isArrayIntOrArrayString(mixed $value): bool
{
    return isArrayInt($value) || isArrayString($value);
}


/** @phpstan-assert-if-true int<min, max>[] $value */
function isArrayInt(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $value1) {
        if (!is_int($value1)) {
            return false;
        }
    }
    return true;
}

/** @phpstan-assert-if-true string[] $value */
function isArrayString(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $value1) {
        if (!is_string($value1)) {
            return false;
        }
    }
    return true;
}
