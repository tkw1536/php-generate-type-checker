---
input: "list<int>"
output: function
---
/** @phpstan-assert-if-true list<int> $value */
function isListInt(mixed $value): bool
{
    if (
        !is_array($value) ||
        !array_is_list($value)
    ) {
        return false;
    }
    foreach ($value as $value1) {
        if (!is_int($value1)) {
            return false;
        }
    }
    return true;
}
