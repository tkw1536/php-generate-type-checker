---
input: "array<array<never>>|array<never>"
output: function
---
/** @phpstan-assert-if-true array<array<never>>|array<never> $value */
function isArrayArrayNeverArrayNever(mixed $value): bool
{
    if ($value === []) {
        return true;
    }
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $value1) {
        if ($value1 !== []) {
            return false;
        }
    }
    return true;
}
