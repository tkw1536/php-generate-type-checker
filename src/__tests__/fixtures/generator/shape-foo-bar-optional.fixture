---
input: "array{foo: int, bar?: string}"
output: function
---
<?php

/** @phpstan-assert-if-true array{foo: int, bar?: string} $value */
function check(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    if (!array_key_exists('foo', $value)) {
        return false;
    }
    $value_foo = $value['foo'];
    if (!is_int($value_foo)) {
        return false;
    }
    if (array_key_exists('bar', $value)) {
        $value_bar = $value['bar'];
        if (!is_string($value_bar)) {
            return false;
        }
    }
    return true;
}
