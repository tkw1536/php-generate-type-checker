---
input: "(array<string|null,mixed>)|null"
output: function
---
<?php

/**
 * @param mixed $data
 * @phpstan-assert-if-true (array<string|null,mixed>)|null $data
 */
function checkType(mixed $data): bool
{
    if ($data === null) {
        return true;
    }
    if (is_array($data)) {
        foreach ($data as $key => $value) {
            if (!((is_string($key) || $key === null))) {
                return false;
            }
        }
        return true;
    }
    return false;
}
