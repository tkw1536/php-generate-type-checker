---
input: "(array<string|null,mixed>)|null"
output: function
---
<?php

/** @phpstan-assert-if-true array<null|string, mixed>|null $value */
function check(mixed $value): bool
{
    return $value === null || check_1($value);
}


/** @phpstan-assert-if-true array<null|string, mixed> $value */
function check_1(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $key1 => $value1) {
        if (!(is_string($key1) || $key1 === null)) {
            return false;
        }
    }
    return true;
}
