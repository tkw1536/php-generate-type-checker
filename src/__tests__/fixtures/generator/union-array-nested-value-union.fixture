---
input: "array<int|array<int>|array<string>>"
output: function
---
<?php

/** @phpstan-assert-if-true array<array<int>|array<string>|int> $value */
function check(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $value1) {
        if (!(is_int($value1) || check_1($value1) || check_2($value1))) {
            return false;
        }
    }
    return true;
}


/** @phpstan-assert-if-true array<int> $value */
function check_1(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $value1) {
        if (!is_int($value1)) {
            return false;
        }
    }
    return true;
}

/** @phpstan-assert-if-true array<string> $value */
function check_2(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $value1) {
        if (!is_string($value1)) {
            return false;
        }
    }
    return true;
}
