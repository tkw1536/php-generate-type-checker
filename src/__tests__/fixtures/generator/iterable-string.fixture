---
input: "iterable<string>"
output: function
---
/** @phpstan-assert-if-true iterable<string> $value */
function isArrayString(mixed $value): bool
{
    if (!is_iterable($value)) {
        return false;
    }
    foreach ($value as $value1) {
        if (!is_string($value1)) {
            return false;
        }
    }
    return true;
}
