---
input: "iterable<string>"
output: function
---
<?php

/**
 * @param mixed $data
 * @phpstan-assert-if-true iterable<string> $data
 */
function checkType(mixed $data): bool
{
    if (!is_iterable($data)) {
        return false;
    }
    foreach ($data as $value) {
        if (!(is_string($value))) {
            return false;
        }
    }
    return true;
}
