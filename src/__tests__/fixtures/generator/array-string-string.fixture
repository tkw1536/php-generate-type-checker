---
input: "array<string, string>"
output: function
---
<?php

/**
 * @param mixed $data
 * @phpstan-assert-if-true array<string, string> $data
 */
function checkType(mixed $data): bool
{
    if (!is_array($data)) {
        return false;
    }
    foreach ($data as $key => $value) {
        if (!(is_string($key)) || !(is_string($value))) {
            return false;
        }
    }
    return true;
}
