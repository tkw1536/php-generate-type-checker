---
input: "(array<string|null,mixed>)|null"
output: public_static
---
class TypeChecker
{
    /** @phpstan-assert-if-true array<null|string, mixed>|null $value */
    public static function isNullTypeOrArrayNullTypeOrStringToMixedType(mixed $value): bool
    {
        return $value === null || self::isArrayNullTypeOrStringToMixedType($value);
    }

    /** @phpstan-assert-if-true array<null|string, mixed> $value */
    private static function isArrayNullTypeOrStringToMixedType(mixed $value): bool
    {
        if (!is_array($value)) {
            return false;
        }
        foreach ($value as $key1 => $value1) {
            if (!(is_string($key1) || $key1 === null)) {
                return false;
            }
        }
        return true;
    }
}
