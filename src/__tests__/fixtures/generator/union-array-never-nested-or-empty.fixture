---
input: "array<array<never>>|array<never>"
output: function
---
/** @phpstan-assert-if-true array<array<never>>|array<never> $value */
function isArrayArrayNeverOrArrayNever(mixed $value): bool
{
    return isArrayArrayNever($value) || $value === [];
}


/** @phpstan-assert-if-true array<array<never>> $value */
function isArrayArrayNever(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    foreach ($value as $value1) {
        if ($value1 !== []) {
            return false;
        }
    }
    return true;
}
