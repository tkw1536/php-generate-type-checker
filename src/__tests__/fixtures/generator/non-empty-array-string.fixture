---
input: "non-empty-array<string>"
output: function
---
<?php

/**
 * @param mixed $data
 * @phpstan-assert-if-true non-empty-array<string> $data
 */
function checkType(mixed $data): bool
{
    if (!is_array($data) || $data === []) {
        return false;
    }
    foreach ($data as $value) {
        if (!(is_string($value))) {
            return false;
        }
    }
    return true;
}
