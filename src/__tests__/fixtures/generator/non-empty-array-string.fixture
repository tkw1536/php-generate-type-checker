---
input: "non-empty-array<string>"
output: function
---
<?php

/** @phpstan-assert-if-true non-empty-array<string> $value */
function check(mixed $value): bool
{
    if (!is_array($value) || $value === []) {
        return false;
    }
    foreach ($value as $value1) {
        if (!is_string($value1)) {
            return false;
        }
    }
    return true;
}
