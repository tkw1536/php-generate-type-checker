---
input: "array{hello: string}"
output: function
---
<?php

/**
 * @param mixed $data
 * @phpstan-assert-if-true array{hello: string} $data
 */
function checkType(mixed $data): bool
{
    if (!is_array($data)) {
        return false;
    }
    if (!array_key_exists('hello', $data)) {
        return false;
    }
    $field_hello = $data['hello'];
    if (!(is_string($field_hello))) {
        return false;
    }
    return true;
}
