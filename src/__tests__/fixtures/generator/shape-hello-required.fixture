---
input: "array{hello: string}"
output: function
---
<?php

/** @phpstan-assert-if-true array{hello: string} $value */
function check(mixed $value): bool
{
    if (!is_array($value)) {
        return false;
    }
    if (!array_key_exists('hello', $value)) {
        return false;
    }
    $value_hello = $value['hello'];
    if (!is_string($value_hello)) {
        return false;
    }
    return true;
}
