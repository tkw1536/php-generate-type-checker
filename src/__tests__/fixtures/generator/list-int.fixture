---
input: "list<int>"
output: function
---
<?php

/**
 * @param mixed $data
 * @phpstan-assert-if-true list<int> $data
 */
function checkType(mixed $data): bool
{
    if (!is_array($data)) {
        return false;
    }
    if (!array_is_list($data)) {
        return false;
    }
    foreach ($data as $value) {
        if (!(is_int($value))) {
            return false;
        }
    }
    return true;
}
