digraph pipeline {
  rankdir=TB;
  node [shape=box, style=rounded];
  splines = ortho;

  inline    [label="Inline helpers"];
  dedupe    [label="Dedupe"];
  unnest    [label="Unnest"];
  combine   [label="Combine"];
  flatten   [label="Flatten"];
  facts     [label="Known facts"];
  simplify  [label="Simplify"];
  dce       [label="Dead-code elimination"];
  simplify2 [label="Simplify again"];
  prune     [label="Prune unused helpers"];

  inline    -> dedupe    -> unnest  -> combine -> flatten -> facts -> simplify -> dce -> simplify2;
  simplify2    -> inline  [label="         changed", constraint=false];
  simplify2 -> prune     [label=" stable"];
}