{
  "name": "php-generate-type-checker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "update_fixtures:generator": "node ./src/generator/testdata/update-testdata.mjs",
    "review_fixtures:generator": "node ./src/generator/testdata/review-fixtures.mjs",
    "update_fixtures:parser": "node ./src/parser/testdata/update-testdata.mjs",
    "test:watch": "vitest",
    "spellcheck": "cspell ."
  },
  "devDependencies": {
    "cspell": "^10.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  },
  "packageManager": "yarn@4.14.1"
}
