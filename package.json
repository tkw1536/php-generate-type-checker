{
  "name": "php-generate-type-checker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "report:optimizer-stats": "node ./src/generator/testdata/report-optimizer-stats.mjs",
    "update_fixtures:generator": "node ./src/generator/testdata/update-testdata.mjs",
    "review_fixtures:generator": "node ./src/generator/testdata/review-fixtures.mjs",
    "update_fixtures:parser": "node ./src/parser/testdata/update-testdata.mjs",
    "test:watch": "vitest",
    "spellcheck": "cspell .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "cspell": "^10.3.6",
    "happy-dom": "^20.14.6",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "highlight.js": "^11.12.0"
  },
  "packageManager": "yarn@4.18.0"
}
