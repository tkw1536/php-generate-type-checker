{
  "name": "php-generate-type-checker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "update_fixtures:generator": "node ./src/generator/testdata/update-testdata.mjs",
    "review_fixtures:generator": "node ./src/generator/testdata/review-fixtures.mjs",
    "update_fixtures:parser": "node ./src/parser/testdata/update-testdata.mjs",
    "test:watch": "vitest",
    "spellcheck": "cspell ."
  },
  "devDependencies": {
    "cspell": "^10.2.0",
    "happy-dom": "^20.13.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "highlight.js": "^11.12.0"
  },
  "packageManager": "yarn@4.18.0"
}
